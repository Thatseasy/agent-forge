{
  "skill-guard-suite": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path('hooks/pre_invocation_router.py' if os.path.exists('hooks/pre_invocation_router.py') else '.agents/hooks/pre_invocation_router.py', run_name='__main__')\"",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path('hooks/pre_tool_guard.py' if os.path.exists('hooks/pre_tool_guard.py') else '.agents/hooks/pre_tool_guard.py', run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "read_file|view_file|write_file|edit_file|write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path('hooks/post_tool_tracker.py' if os.path.exists('hooks/post_tool_tracker.py') else '.agents/hooks/post_tool_tracker.py', run_name='__main__')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path('hooks/stop_quality_nudge.py' if os.path.exists('hooks/stop_quality_nudge.py') else '.agents/hooks/stop_quality_nudge.py', run_name='__main__')\"",
        "timeout": 15
      }
    ]
  }
}
